<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.canvas.Canvas?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER"
      spacing="14.0"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.example.lab2.HelloController">
    <padding>
        <Insets bottom="18.0" left="18.0" right="18.0" top="18.0"/>
    </padding>

    <Label fx:id="statusLabel"
           text="Баланс: 0 | Сыграно: 0"
           style="-fx-font-size: 16px; -fx-font-weight: bold;"/>

    <Canvas fx:id="canvas" width="640.0" height="360.0"/>

    <HBox alignment="CENTER" spacing="12.0">
        <Button text="Кинуть монетку" onAction="#onPay" prefWidth="170.0"/>
        <Button text="Старт" onAction="#onStart" prefWidth="170.0"/>
    </HBox>
</VBox>
